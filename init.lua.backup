  { char = "ω", name = "omega" },
  { char = "Δ", name = "Delta (upper)" },
  { char = "Γ", name = "Gamma (upper)" },
  { char = "Λ", name = "Lambda (upper)" },
  { char = "Σ", name = "Sigma (upper)" },
  { char = "Ω", name = "Omega (upper)" },
}

local function open_symbol_picker()
  local lines = {}
  for _, s in ipairs(symbols) do
    table.insert(lines, "  " .. s.char .. "  " .. s.name)
  end

  local buf = vim.api.nvim_create_buf(false, true)
  vim.api.nvim_buf_set_lines(buf, 0, -1, false, lines)
  vim.bo[buf].modifiable = false

  local width = 36
  local height = math.min(#lines, 20)
  local row = math.floor((vim.o.lines - height) / 2)
  local col = math.floor((vim.o.columns - width) / 2)

  local win = vim.api.nvim_open_win(buf, true, {
    relative = "editor",
    width = width,
    height = height,
    row = row,
    col = col,
    style = "minimal",
    border = "rounded",
    title = " Math Symbols ",
    title_pos = "center",
  })

  vim.wo[win].cursorline = true

  local function close()
    vim.api.nvim_win_close(win, true)
    vim.api.nvim_buf_delete(buf, { force = true })
  end

  local function pick()
    local cursor_line = vim.api.nvim_win_get_cursor(win)[1]
    local symbol = symbols[cursor_line].char
    vim.fn.setreg("+", symbol)   -- system clipboard
    vim.fn.setreg('"', symbol)   -- default register
    close()
    vim.notify("Copied: " .. symbol, vim.log.levels.INFO)
  end

  local opts = { buffer = buf, nowait = true }
  vim.keymap.set("n", "<CR>", pick,  opts)
  vim.keymap.set("n", "q",    close, opts)
  vim.keymap.set("n", "<Esc>", close, opts)
end


