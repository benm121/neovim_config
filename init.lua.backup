  { char = "∄", name = "there does not exist" },
  { char = "∈", name = "element of" },
  { char = "∉", name = "not element of" },
  { char = "⊂", name = "subset of" },
  { char = "⊆", name = "subset of or equal" },
  { char = "⊃", name = "superset of" },
  { char = "∪", name = "union" },
  { char = "∩", name = "intersection" },
  { char = "∅", name = "empty set" },
  { char = "∞", name = "infinity" },
  { char = "√", name = "square root" },
  { char = "≈", name = "approximately equal" },
  { char = "⇒", name = "implies / to" },
  { char = "⇔", name = "if and only if" },
  { char = "¬", name = "negation" },
  { char = "∧", name = "logical and" },
  { char = "∨", name = "logical or" },
  { char = "⊕", name = "xor / direct sum" },
  { char = "ℝ", name = "real numbers" },
  { char = "ℤ", name = "integers" },
  { char = "ℕ", name = "natural numbers" },
  { char = "ℚ", name = "rationals" },
  { char = "ℂ", name = "complex numbers" },
  { char = "ℙ", name = "primes / projective" },
  { char = "α", name = "alpha" },
  { char = "β", name = "beta" },
