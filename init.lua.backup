  { char = "v̂", name = "unit vector v" },
  { char = "ŵ", name = "unit vector w" },
  { char = " ", name = " " },
  { char = " ", name = "logic/set" },
  { char = " ", name = " " },
  { char = "∀", name = "for all" },
